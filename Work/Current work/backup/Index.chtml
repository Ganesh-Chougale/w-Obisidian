@using ZanvarGroup.Erp.Business.Configs;
@using ZanvarGroup.Erp.Business.Masters

@{
    List<Branch> branch = ViewData["branchList"] as List<Branch>;

    int? ActiveType = ViewData["AciveType"] as Nullable<int>;
    int? StockListGroupCode = ViewData["StockListGroupCode"] as Nullable<int>;
    int? BranchCode = ViewData["BranchCode"] as Nullable<int>;
    int? MaterialCode = ViewData["MaterialCode"] as Nullable<int>;
    string MaterialName = ViewData["MaterialName"] as string;


}

<div id="content">
    <article class="col-sm-12 col-md-12 col-lg-12">

        <input type="hidden" id="hfIncomingActiveType" value="@ActiveType" />
        <input type="hidden" id="hfIncomingSlgCode" value="@StockListGroupCode" />
        <input type="hidden" id="hfIncomingBranchCode" value="@BranchCode" />
        <input type="hidden" id="hfIncomingMaterialCode" value="@MaterialCode" />
        <input type="hidden" id="hfIncomingMaterialName" value="@MaterialName" />

        <div class="jarviswidget jarviswidget-color-blueDark" id="wid-id-1" data-widget-colorbutton="false"
             data-widget-editbutton="false" data-widget-custombutton="false">
            <header>
                <h2>Branch and Department Wise Minimum Maximum </h2>
            </header>
            <div>
                <div class="widget-body no-padding">
                    <form id="BranchDeptMinMax-form" class="smart-form client-form">
                        <fieldset>

                            <section class="col-md-12">

                                <div class="col-md-6">
                                    <div class="col-md-3">
                                        <label class="label">Select Type</label>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="col-md-4">
                                            <label class="radio radio-inline">
                                                <input type="radio" class="radiobox" value="0" name="activeType">
                                                <span class="label">Stock list group wise</span>
                                            </label>
                                        </div>
                                        <div class="col-md-1"></div>
                                        <div class="col-md-4">
                                            <label class="radio radio-inline">
                                                <input type="radio" class="radiobox" value="1" name="activeType">
                                                <span class="label">Item wise</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-1"></div>

                                <div class="col-md-5">
                                    <div class="col-md-3">
                                        <label class="label">Branch</label>
                                    </div>

                                    <div class="col-md-5">
                                        <label class="select">
                                            <select name="ddlUnit" id="ddlUnit" style="width:100%">
                                                @foreach (Branch _branch in branch)
                                                {
                                                    if (BranchCode != 0 || BranchCode != null)
                                                    {
                                                        <option @(BranchCode == _branch.BranchCode ? "selected=selected" : "") value="@_branch.BranchCode">@_branch.LongName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@_branch.BranchCode">@_branch.LongName</option>
                                                    }
                                                }
                                            </select>
                                        </label>
                                    </div>
                                </div>

                            </section>

                            <section>
                                <div class="col-md-12" id="radioOutput" style="margin-bottom:25px;">
                                    <!-- dynamic generation by js -->
                                </div>
                            </section>

                            <section>
                                <div class="col-md-12" id="tableArea">
                                    <!-- dynamic generation by js -->
                                </div>
                            </section>



                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </article>
</div>

<!-- stock list group Popup -->
