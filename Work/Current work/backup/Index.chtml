<!--./ stock list group Popup -->

<style>
    #slg_table thead,
    #slg_table thead th {
        background-color: #092347 !important;
    }

    #slg_table thead th {
        text-align: center;
    }

    #slg_table tbody td {
        font-weight: 900 !important;
    }

    #SLGDataTable thead,
    #SLGDataTable thead th {
        background-color: #092347 !important;
    }

    #item_MM_table thead,
    #item_MM_table thead th {
        background-color: #092347 !important;
    }

    #item_MM_table tbody td {
        font-weight: 900 !important;
    }

    #item_MM_table thead th {
        text-align: center;
    }

    #item_Whole_table thead,
    #item_Whole_table thead th {
        background-color: #092347 !important;
    }

    #item_Whole_table tbody td {
        font-weight: 900 !important;
    }

    #item_Whole_table thead th {
        text-align: center;
    }

</style>


<script type="text/javascript">
    $(document).ready(function () {

        $("#ddlUnit").select2();

        $(document).on('change', '#ddlUnit', function () {

            var activeType = $("input[name='activeType']:checked").val();

            if (activeType == 0) {
                var selectedSlg = $("#ddlStockListGroup").val();
                if (selectedSlg == 0 || selectedSlg == null || selectedSlg == "") {
                    customWarning("#ddlStockListGroup", "Stock List Group", "Stock list group is not selected", "#C46A69", 3000)
                    return;
                }
                else {
                    StockListDataShow();
                }
            } else if (activeType == 1) {

                var selectedMaterialCode = $("#hfMatCode").val();
                if (selectedMaterialCode != 0 || selectedMaterialCode != null) {
                    ItemSelect();
                } else {
                    customWarning("#inpMatName", "Material Item", "Item is not selected", "#C46A69", 3000)
                }
            }

        });

        var incomingActiveType = $("#hfIncomingActiveType").val();
        var incomingBranchCode = $("#hfIncomingBranchCode").val();


        if (incomingBranchCode && incomingActiveType == 0) {
            $("input[name='activeType'][value='0']").prop('checked', true).trigger("change");
        } else if (incomingBranchCode && incomingActiveType == 1) {
            $("input[name='activeType'][value='1']").prop('checked', true).trigger("change");
            var incomingMaterialCode = $("#hfIncomingMaterialCode").val();
            $("#hfMatCode").val(incomingMaterialCode);
        }

        $(document).on('change', '#ddlStockListGroup', function () {
            StockListDataShow()
        });


    });// doc.ready end



    function customWarning(p_focus_id, p_title, p_description, p_color, p_time_in_ms) {

        $(p_focus_id).focus();

        $.smallBox({
            title: p_title,
            content: p_description,
            color: p_color,
            timeout: p_time_in_ms
        });
    }


    $(document).off("change", "input[name='activeType']").on("change", "input[name='activeType']", function () {

        var activeType = $("input[name='activeType']:checked").val();

        $("#radioOutput").empty();
        $("#tableArea").empty();

        if (activeType == 0) {

            var stockListGroupDDL = `
                <div class="col-md-9">
                    <div class="col-md-2">
                        <label class="label">Stock List Group</label>
                    </div>

                    <div class="col-md-6">
                        <label class="select">
                            <select name="ddlStockListGroup" id="ddlStockListGroup" style="width:100%">
                                <option></option>
                            </select>
                        </label>
                    </div>
                </div>
                `;

            $("#radioOutput").html(stockListGroupDDL);
            $("#ddlStockListGroup").select2();
            loadStockGroups();
        } else if (activeType == 1) {

            var materialInput = `
                <div class ="col-md-6">
                    <div class ="col-md-3">
                        <label class ="label"> Material Name </label>
                    </div>
                    <div class ="col-md-9">
                        <label class ="input">
                            <input type="text" id="inpMatName" name="inpMatName" class ="form-control input-xs" placeholder="Material Name" />
                            <input type="hidden" id="hfMatCode" name="hfMatCode" />
                            <b class ="tooltip tooltip-top-right">
                                <i class ="fa fa-warning txt-color-teal"></i>
                                Please Enter Material Name
                            </b>
                        </label>
                    </div>
                </div>

                <div class ="col-md-12" id="ItemHeaderRectangle" style="margin-bottom:25px;"></div>
                `;

            $("#radioOutput").html(materialInput);

            var incomingMaterialCode = $("#hfIncomingMaterialCode").val();
            var incomingMaterialName = $("#hfIncomingMaterialName").val();
            if (incomingMaterialCode && incomingMaterialName) {
                //$("#inpMatName").val(incomingMaterialCode);
                $("#inpMatName").val(incomingMaterialName);
            }
            ItemMaterialAutocomplete();
        }

    });


    function StockListDataShow() {

        var selectedBranchCode = $("#ddlUnit").val();
        var selectedSlg = $("#ddlStockListGroup").val();

        var urlString = "/BranchDeptMinMax/StockListGroupWiseData?intBranchCode=" + selectedBranchCode + "&intStockListCode=" + selectedSlg;

        debugger;

        $.ajax({
            url: urlString,
            type: "POST",
            dataType: "json",
            success: function (data) {
                console.log(data)
                var tableArea = $("#tableArea");

                var slg_table = `
                                    <div class="widget-body no-padding">
                                        <table id="slg_table" class="table table-striped table-bordered" width="100%">
                                            <thead >
                                                <tr>
                                                    <th rowspan="2">Item Code</th>
                                                    <th rowspan="2" style="width:15%;" >Item Description</th>
                                                    <th rowspan="2">Material Category</th>
                                                    <th rowspan="2">Avg Consump.<br />(Last 6 Mths) </th>
                                                    <th rowspan="2">Avg Daily<br />Consumption</th>
                                                    <th rowspan="2">Current<br />Stock</th>
                                                    <th rowspan="2">Min<br />Stock</th>
                                                    <th rowspan="2">Max<br />Stock</th>
                                                    <th rowspan="2">Days of<br />Stock Left</th>
                                                    <th rowspan="2">Mate Pur<br />Lead Time</th>
                                                    <th rowspan="2">Consumption<br />Trend</th>
                                                    <th rowspan="2">Stock<br />Movement</th>
                                                    <th colspan="2">Pipeline Qty</th>
                                                    <th rowspan="2">Net Available<br />(Current +Pipeline) </th>
                                                    <th rowspan="2">Stock<br />Signal</th>
                                                    <th rowspan="2">Procurement<br />Priority</th>
                                                    <th rowspan="2">Action</th>
                                                </tr>
                                                <tr>
                                                    <th>Available MDN</th>
                                                    <th>Available Po</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                `;
                tableArea.html(slg_table);

                var rows = "";
                $.each(data, function (i, item) {

                    var colorFlag = "";

                    if (item.AvgConsumption > 0) {
                        if (((item.CurrentStock / item.AvgConsumption) * 100) <= 10) {
                            colorFlag = "black";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 10 && ((item.CurrentStock / item.AvgConsumption) * 100) <= 30) {
                            colorFlag = "red";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 30 && ((item.CurrentStock / item.AvgConsumption) * 100) <= 60) {
                            colorFlag = "yellow";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 60) {
                            colorFlag = "green";
                        }
                    }

                    rows += `
                           <tr class ="${(item.StatusCode == 1 ? 'deleted' : (item.StatusCode == 101 ? 'approvalpend' : (item.StatusCode == 2 ? 'unapproved' : (item.StatusCode == 11 ? 'amend' : ''))))}">


                                <td class ="materialCode" data-materialcodeval="${item.MaterialCode}"> ${item.MaterialCode}</td>
                                <td> ${item.MaterialName} </td>
                                <td ${item.CovType === 'Runner' ? "style='color:#5E79E2;'" : ""} > ${item.CovType} </td>
                                <td style="text-align:right;"> ${item.AvgConsumption} </td>
                                <td style="text-align:right;"> ${item.AvgDailyConsupmtion} </td>`

                        if (item.AvgConsumption > 0) {
                            if (colorFlag == "black") {
                                rows += `<td class ="currentStock" style="text-align:right;"> ${item.CurrentStock} </td>`
                            } else if (colorFlag == "red") {
                                rows += `<td class ="currentStock" style="text-align:right;; color:#E4201C;"> ${item.CurrentStock} </td>`
                            } else if (colorFlag == "yellow") {
                                rows += `<td class ="currentStock" style="text-align:right; color:#FE9425;"> ${item.CurrentStock} </td>`
                            } else if (colorFlag == "green") {
                                rows += `<td class ="currentStock" style="text-align:right; color:#00A228;"> ${item.CurrentStock} </td>`
                            }
                        } else {
                            rows += `<td class ="currentStock" style="text-align:right;"> ${item.CurrentStock} </td>`
                        }

                            rows += `
                                    <td style="text-align:right;"> ${item.SumOfMinQty} </td>
                                    <td style="text-align:right;"> ${item.SumOfMaxQty} </td>`

                            if (item.CurrentStock > 0) {
                                rows += `<td style="text-align:right;"> ${item.DaysOfStockLeft} </td>`
                            } else {
                                rows += `<td> </td>`
                            }
                            rows += `<td>${item.LeadTime}</td>`
                            if (item.AvgDailyConsupmtion < item.CurrentMonthDailyConsuption) {
                                rows += `<td style="text-align:center;">
                                            <span style="font-size:20px; color:#00751B; display:inline-block; transform:scaleX(1.5);">↑</span>
                                            <span style="font-weight: 700;">&nbsp; Increasing</span>
                                        </td>
                                        <td style="text-align:center;">
                                            <span class ="text-success" style="font-size:20px;font-weight:900;">🔥</span>
                                            <span style="font-weight: 700;">Fast</span>
                                        </td>
                                        `
                            } else if (item.AvgDailyConsupmtion = item.CurrentMonthDailyConsuption) {
                                rows += `<td style="text-align:center;">
                                            <span style="color:#3f51ff;font-size:20px;display:inline-block; transform:scaleY(1.5);">→</span>
                                            <span style="font-weight: 700;">&nbsp; Stable</span>
                                        </td>
                                        <td style="text-align:center;">
                                            <span class ="text-danger" style="font-size:20px;font-weight:900;">⚡️</span>
                                            <span style="font-weight: 700;">&nbsp; Medium</span>
                                        </td>`
                            } else if (item.AvgDailyConsupmtion > item.CurrentMonthDailyConsuption) {
                                rows += `<td style="text-align:center;">
                                            <span class ="text-danger" style="font-size:20px;font-weight:900;">↘</span>
                                            <span style="font-weight: 700;">&nbsp; Decreasing</span>
                                        </td>
                                        <td style="text-align:center;">
                                            <span style="color:#3f51ff;font-size:20px;font-weight:900;">🐢</span>
                                            <span style="font-weight: 700;">&nbsp; Slow</span>
                                        </td>`
                            } else {
                                rows += `<td> </td>
                                         <td> </td>`
                            }

                            if (item.AvailableMdn > 0) {
                                rows += `
                            <td style="text-align:right;">
                                        <a title="View" href="BranchDeptMinMax/OrderList" data-ajax-update="#mainContent" data-ajax-mode="replace" data-ajax-method="GET" data-ajax="true">
                                            ${item.AvailableMdn}
                                        </a>
                            </td>`
                            } else {
                                rows += `
                            <td style="text-align:right;">
                                ${item.AvailableMdn}
                            </td>`
                            }

                                rows += `
                                        <td style="text-align:right;"> ${item.AvailablePo} </td>
                                        <td style="text-align:right;"> ${item.CurrentStock +item.AvailableMdn +item.AvailablePo} </td>`

                                if (item.AvgConsumption > 0) {
                                    if (colorFlag == "black") {
                                        rows += `<td style="text-align:center;">
                                                    <div class="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #ffffff; outline: 1px solid #000000; pointer-events: none;">
                                                        <i class="fa fa-circle" style="color:#000000;"></i>
                                                        <strong style="color:#000000;font-weight: 900;">Black</strong>
                                                    </div>
                                                 </td>

                                                <td style="color:#000000;font-weight: 900; text-align:center;">Purchase today</td>

                                                `
                                    } else if (colorFlag == "red") {
                                        rows += `<td style="text-align:center;">
                                                    <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #FCEEEE; outline: 1px solid #E4201C; pointer-events: none;">
                                                        <i class ="fa fa-circle" style="color:#E4201C;"></i>
                                                        <strong style="color:#E4201C;font-weight: 900;">Red</strong>
                                                    </div>
                                                 </td>

                                                 <td style="color:#E4201C;font-weight: 900; text-align:center;">Purchase this week</td>`
                                    } else if (colorFlag == "yellow") {
                                        rows += `<td style="text-align:center;">
                                                    <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #FDF6D0; outline: 1px solid #FE9425; pointer-events: none;">
                                                        <i class ="fa fa-circle" style="color:#FE9425;"></i>
                                                        <strong style="color:#FE9425;font-weight: 900; text-align:center;">Yellow</strong>
                                                    </div>
                                                 </td>

                                                 <td style="color:#FE9425;font-weight: 900; text-align:center;">Purchase next week</td>`
                                    } else if (colorFlag == "green") {
                                        rows += `<td style="text-align:center;">
                                                    <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #EDF8F1; outline: 1px solid #00A228; pointer-events: none;">
                                                        <i class ="fa fa-circle" style="color:#00A228;"></i>
                                                        <strong style="color:#00A228;font-weight: 900;">Green</strong>
                                                    </div>
                                                 </td>

                                                 <td style="color:#00A228;font-weight: 900;">No action</td>
                                                 `
                                    }
                                } else {
                                    rows += `<td> </td>
                                             <td> </td>`
                                }
                                if (item.StatusCode == 101) {
                                    rows += `<td style="text-align:center;">Approval Pending</td>`
                                }else if ((item.CovType != "Stranger") && (item.DaysOfStockLeft <= item.LeadTime)) {

                                    rows += `<td>
                                                <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #FAFBFC; outline: 1px solid #5E79E2;" onclick="goCreateMdn(this)">
                                                    <strong style="color:#5E79E2; font-weight: 900;"">Raise MDN</strong>
                                                </div>
                                            </td>`
                                } else {
                                    rows += `<td></td>`
                                }
                            rows += `</tr>`;
                });
                $("#slg_table tbody").empty();
                $("#slg_table tbody").html(rows);
            },
            error: function (xhr) {
                var message = "Error: " + xhr.status + " - " + xhr.statusText;
                customWarning("", "Error in flow", message, "#C46A69", 1000);
            }
        });
    }



    function loadStockGroups() {

        var incomingSlgCode = $("#hfIncomingSlgCode").val();

        $.ajax({
            url: "BranchDeptMinMax/GetStockListGroupName",
            type: "POST",
            async: "false",
            success: function (data) {
                var ddlSG = $("#ddlStockListGroup");
                ddlSG.empty();
                ddlSG.append('<option></option>');

                $.each(data, function (i, item) {

                    ddlSG.append(
                        `
                        <option ${incomingSlgCode == item.StockGroupCcode ? "selected='selected'": ""} value="${item.StockGroupCcode}">
                            ${item.LongName}
                        </option>
                        `
                    );

                });
                ddlSG.trigger("change.select2");
                if (incomingSlgCode) {
                    StockListDataShow();
                }
            },
            error: function (xhr) {
                alert(xhr.responseText);
            }
        });
    }

    function ItemMaterialAutocomplete() {
        debugger;
        var incomingMaterialCode = $("#hfIncomingMaterialCode").val();
        var incomingMaterialName = $("#hfIncomingMaterialName").val();
        $("#hfMatCode").val(incomingMaterialCode);

        if (incomingMaterialCode && incomingMaterialName) {
            ItemSelect();
            return
        }

        $("#inpMatName").keyup(function () {
            if ($("#inpMatName").val().trim().length >= 3) {
                dontBlock = true;
            }
        });

        $("#inpMatName").autocomplete({

            minLength: 3,
            source: function (request, response) {

                $.ajax({
                    url: "BranchDeptMinMax/GetMaterialAutoFill",
                    type: "POST",
                    dataType: "json",
                    data: {
                        searchString: request.term
                    },
                    success: function (data) {

                        dontBlock = false;

                        let items = [];
                        let map = {};

                        $.each(data, function (i, item) {
                            map[item.MaterialName] = {
                                id: item.MaterialCode,
                                name: item.MaterialName
                            };
                            items.push(item.MaterialName);
                        });
                        window.materialMap = map;
                        response(items);
                        $(".dropdown-menu").css("height", "auto");
                    },

                    error: function (response) {
                        dontBlock = false;
                        alert(response.responseText);
                    }
                });
            },

            select: function (event, ui) {
                $("#hfMatCode").val(
                    window.materialMap[ui.item.value].id
                );
                $("#inpMatName").val(
                    window.materialMap[ui.item.value].name
                );
                ItemSelect();
            }
        });
    }

    function ItemSelect() {

        debugger;

        var selectedBranchCode = $("#ddlUnit").val();
        var selectedMaterialCode = $("#hfMatCode").val();

        if (!selectedBranchCode || !selectedMaterialCode) {
            return;
        }

        var itemRectangle = $("#ItemHeaderRectangle");
        itemRectangle.empty();
        var tableArea = $("#tableArea");
        tableArea.empty();

        var urlString = "/BranchDeptMinMax/ItemWiseData?intBranchCode=" + selectedBranchCode + "&intMaterialCode=" + selectedMaterialCode;

        $.ajax({
            url: urlString,
            type: "POST",
            dataType: "json",
            success: function (data) {
                if (data.length > 0) {

                    var item_Whole_table = `
                                    <div class ="widget-body no-padding" style="margin-top:25px;">
                                        <table id="item_Whole_table" class ="table table-striped table-bordered" width="100%">
                                            <thead >
                                                <tr>
                                                    <th rowspan="2">Item Code</th>
                                                    <th rowspan="2" style="width:15%;" >Item Description</th>
                                                    <th rowspan="2">Material Category</th>
                                                    <th rowspan="2">Avg Consump.<br />(Last 6 Mths) </th>
                                                    <th rowspan="2">Avg Daily<br />Consumption</th>
                                                    <th rowspan="2">Current<br />Stock</th>
                                                    <th rowspan="2">Min<br />Stock</th>
                                                    <th rowspan="2">Max<br />Stock</th>
                                                    <th rowspan="2">Days of<br />Stock Left</th>
                                                    <th rowspan="2">Mate Pur<br />Lead Time</th>
                                                    <th rowspan="2">Consumption<br />Trend</th>
                                                    <th rowspan="2">Stock<br />Movement</th>
                                                    <th colspan="2">Pipeline Qty</th>
                                                    <th rowspan="2">Net Available<br />(Current +Pipeline) </th>
                                                    <th rowspan="2">Stock<br />Signal</th>
                                                    <th rowspan="2">Procurement<br />Priority</th>
                                                    <th rowspan="2">Action</th>
                                                </tr>
                                                <tr>
                                                    <th>Available MDN</th>
                                                    <th>Available Po</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                <hr style="background-color:#092347; height: 1px;" />
                                `;

                    itemRectangle.html(item_Whole_table);

                    var rows = "";
                    $.each(data, function (i, item) {

                        var colorFlag = "";

                        if (((item.CurrentStock / item.AvgConsumption) * 100) <= 10) {
                            colorFlag = "black";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 10 && ((item.CurrentStock / item.AvgConsumption) * 100) <= 30) {
                            colorFlag = "red";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 30 && ((item.CurrentStock / item.AvgConsumption) * 100) <= 60) {
                            colorFlag = "yellow";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 60) {
                            colorFlag = "green";
                        }

                        rows += `
                                <tr class ="${(item.StatusCode == 1 ? 'deleted' : (item.StatusCode == 101 ? 'approvalpend' : (item.StatusCode == 2 ? 'unapproved' : (item.StatusCode == 11 ? 'amend' : ''))))}">


                                    <td class ="materialCode" data-materialcodeval="${item.MaterialCode}"> ${item.MaterialCode}</td>
                                    <td> ${item.MaterialName} </td>
                                    <td ${item.CovType === 'Runner' ? "style='color:#5E79E2;'": ""} > ${item.CovType} </td>
                                    <td style="text-align:right;"> ${item.AvgConsumption} </td>
                                    <td style="text-align:right;"> ${item.AvgDailyConsupmtion} </td>
                                `

                        if (item.AvgConsumption > 0) {
                            if (colorFlag == "black") {
                                rows += `<td class ="currentStock" style="text-align:right;"> ${item.CurrentStock} </td>`
                            } else if (colorFlag == "red") {
                                rows += `<td class ="currentStock" style="text-align:right;; color:#E4201C;"> ${item.CurrentStock} </td>`
                            } else if (colorFlag == "yellow") {
                                rows += `<td class ="currentStock" style="text-align:right; color:#FE9425;"> ${item.CurrentStock} </td>`
                            } else if (colorFlag == "green") {
                                rows += `<td class ="currentStock" style="text-align:right; color:#00A228;"> ${item.CurrentStock} </td>`
                            }
                        } else {
                            rows += `<td class ="currentStock" style="text-align:right;"> ${item.CurrentStock} </td>`
                        }

                        rows += `
                                        <td style="text-align:right;"> ${item.SumOfMinQty} </td>
                                        <td style="text-align:right;"> ${item.SumOfMaxQty} </td>`

                        if (item.CurrentStock > 0) {
                            rows += `<td style="text-align:right;"> ${item.DaysOfStockLeft} </td>`
                        } else {
                            rows += `<td> </td>`
                        }
                        rows += `<td>${item.LeadTime}</td>`
                        if (item.AvgDailyConsupmtion < item.CurrentMonthDailyConsuption) {
                            rows += `<td style="text-align:center;">
                                            <span style="font-size:20px; color:#00751B; display:inline-block; transform:scaleX(1.5);">↑</span>
                                            <span style="font-weight: 700;">&nbsp; Increasing</span>
                                        </td>
                                        <td style="text-align:center;">
                                            <span class ="text-success" style="font-size:20px;font-weight:900;">🔥</span>
                                            <span style="font-weight: 700;">Fast</span>
                                        </td>
                                        `
                        } else if (item.AvgDailyConsupmtion = item.CurrentMonthDailyConsuption) {
                            rows += `<td style="text-align:center;">
                                            <span style="color:#3f51ff;font-size:20px;display:inline-block; transform:scaleY(1.5);">→</span>
                                            <span style="font-weight: 700;">&nbsp; Stable</span>
                                        </td>
                                        <td style="text-align:center;">
                                            <span class ="text-danger" style="font-size:20px;font-weight:900;">⚡️</span>
                                            <span style="font-weight: 700;">&nbsp; Medium</span>
                                        </td>`
                        } else if (item.AvgDailyConsupmtion > item.CurrentMonthDailyConsuption) {
                            rows += `<td style="text-align:center;">
                                            <span class ="text-danger" style="font-size:20px;font-weight:900;">↘</span>
                                            <span style="font-weight: 700;">&nbsp; Decreasing</span>
                                        </td>
                                        <td style="text-align:center;">
                                            <span style="color:#3f51ff;font-size:20px;font-weight:900;">🐢</span>
                                            <span style="font-weight: 700;">&nbsp; Slow</span>
                                        </td>`
                        } else {
                            rows += `<td> </td>
                                         <td> </td>`
                        }

                        if (item.AvailableMdn > 0) {
                        rows += `
                            <td style="text-align:right;">
                                        <a title="View" href="BranchDeptMinMax/OrderList" data-ajax-update="#mainContent" data-ajax-mode="replace" data-ajax-method="GET" data-ajax="true">
                                            ${item.AvailableMdn}
                                        </a>
                            </td>`
                        } else {
                            rows += `
                            <td style="text-align:right;">
                                ${item.AvailableMdn}
                            </td>`
                        }

                        rows += `
                                    <td style="text-align:right;"> ${item.AvailablePo} </td>
                                    <td style="text-align:right;"> ${item.CurrentStock + item.AvailableMdn + item.AvailablePo} </td>`

                                if (item.AvgConsumption > 0) {
                                    if (colorFlag == "black") {
                                        rows += `<td style="text-align:center;">
                                                    <div class="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #ffffff; outline: 1px solid #000000; pointer-events: none;">
                                                        <i class="fa fa-circle" style="color:#000000;"></i>
                                                        <strong style="color:#000000;font-weight: 900;">Black</strong>
                                                    </div>
                                                 </td>

                                                <td style="color:#000000;font-weight: 900; text-align:center;">Purchase today</td>`
                                    } else if (colorFlag == "red") {
                                        rows += `<td style="text-align:center;">
                                                    <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #FCEEEE; outline: 1px solid #E4201C; pointer-events: none;">
                                                        <i class ="fa fa-circle" style="color:#E4201C;"></i>
                                                        <strong style="color:#E4201C;font-weight: 900;">Red</strong>
                                                    </div>
                                                 </td>

                                                 <td style="color:#E4201C;font-weight: 900; text-align:center;">Purchase this week</td>`
                                    } else if (colorFlag == "yellow") {
                                        rows += `<td style="text-align:center;">
                                                    <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #FDF6D0; outline: 1px solid #FE9425; pointer-events: none;">
                                                        <i class ="fa fa-circle" style="color:#FE9425;"></i>
                                                        <strong style="color:#FE9425;font-weight: 900; text-align:center;">Yellow</strong>
                                                    </div>
                                                 </td>

                                                 <td style="color:#FE9425;font-weight: 900; text-align:center;">Purchase next week</td>`
                                    } else if (colorFlag == "green") {
                                        rows += `<td style="text-align:center;">
                                                    <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #EDF8F1; outline: 1px solid #00A228; pointer-events: none;">
                                                        <i class ="fa fa-circle" style="color:#00A228;"></i>
                                                        <strong style="color:#00A228;font-weight: 900;">Green</strong>
                                                    </div>
                                                 </td>

                                                 <td style="color:#00A228;font-weight: 900;">No action</td>
`
                                    }
                                } else {
                                    rows += `<td> </td>
                                             <td> </td>`
                                }
                                if (item.StatusCode == 101) {
                                    rows += `<td style="text-align:center;">Approval Pending</td>`
                                } else if ((item.CovType != "Stranger") && (item.DaysOfStockLeft <= item.LeadTime)) {

                                    rows += `<td>
                                                        <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #FAFBFC; outline: 1px solid #5E79E2;" onclick="goCreateMdn(this)">
                                                            <strong style="color:#5E79E2; font-weight: 900;"">Raise MDN</strong>
                                                        </div>
                                                 </td>`
                                } else {
                                    rows += `<td></td>`
                                }
                            rows += `</tr>`;
                    });
                    $("#item_Whole_table tbody").empty();
                    $("#item_Whole_table tbody").html(rows);

                    var item_MM_table = `
                                <div class ="widget-body no-padding">
                                    <table id="item_MM_table" class ="table table-striped table-bordered" width="100%">
                                        <thead >
                                            <tr>
                                                <th style="text-align:center;">Dept Name</th>
                                                <th style="text-align:center;">Days of Stock Left</th>
                                                <th style="text-align:center;">Mate Pur<br />Lead Time</th>
                                                <th style="text-align:center;">Consumption Trend</th>
                                                <th style="text-align:center;">Min Max</th>
                                                <th style="text-align:center;">Max Max</th>
                                                <th style="text-align:center;">Stock Movement</th>
                                                <th style="text-align:center;">Stock Signal</th>
                                                <th style="text-align:center;">Procurement Priority</th>
                                                <th style="text-align:center;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                `;
                    tableArea.html(item_MM_table);

                    var rows = "";
                    $.each(data, function (i, item) {

                        var colorFlag = "";

                        if (((item.CurrentStock / item.AvgConsumption) * 100) <= 10) {
                            colorFlag = "black";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 10 && ((item.CurrentStock / item.AvgConsumption) * 100) <= 30) {
                            colorFlag = "red";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 30 && ((item.CurrentStock / item.AvgConsumption) * 100) <= 60) {
                            colorFlag = "yellow";
                        } else if (((item.CurrentStock / item.AvgConsumption) * 100) > 60) {
                            colorFlag = "green";
                        }

                        rows += `
                            <tr>

                                <td style="text-align:left" class ="deptCode" data-deptcodeval="${item.DeptCode}">
                                    ${item.DeptName}
                               </td>
                                <td style="text-align:right;">${item.DaysOfStockLeft}</td>
                                <td style="text-align:right;">${item.LeadTime}</td>`

                    if (item.AvgDailyConsupmtion < item.CurrentMonthDailyConsuption) {
                        rows += `<td style="text-align:center;">
                                        <span style="font-size:20px; color:#00751B; display:inline-block; transform:scaleX(1.5);">↑</span>
                                        <span style="font-weight: 700;">&nbsp; Increasing</span>
                                    </td>
                                    <td>
                                        <input style="width:100%; text-align:right;" oninput="validateDecimalInput(this)" type="text" class ="minQty" value="${item.SumOfMinQty}" onblur="validateMin(this)">
                                    </td>
                                    <td>
                                        <input style="width:100%; text-align:right;" oninput="validateDecimalInput(this)" type="text" class ="maxQty" value="${item.SumOfMaxQty}" onblur="validateMax(this)">
                                    </td>
                                    <td style="text-align:center;">
                                        <span class ="text-success" style="font-size:20px;font-weight:900;">🔥</span>
                                        <span style="font-weight: 700;">&nbsp; Fast</span>
                                    </td>
                                    `
                    } else if (item.AvgDailyConsupmtion = item.CurrentMonthDailyConsuption) {
                        rows += `<td style="text-align:center;">
                                        <span style="color:#3f51ff;font-size:20px;display:inline-block; transform:scaleY(1.5);">→</span>
                                        <span style="font-weight: 700;">Stable</span>
                                    </td>
                                    <td>
                                        <input style="width:100%; text-align:right;" oninput="validateDecimalInput(this)" type="text" class ="minQty" value="${item.SumOfMinQty}" onblur="validateMin(this)">
                                    </td>
                                    <td>
                                        <input style="width:100%; text-align:right;" oninput="validateDecimalInput(this)" type="text" class ="maxQty" value="${item.SumOfMaxQty}" onblur="validateMax(this)">
                                    </td>
                                    <td style="text-align:center;">
                                        <span class ="text-danger" style="font-size:20px;font-weight:900;">⚡️</span>
                                        <span style="font-weight: 700;">&nbsp; Medium</span>
                                    </td>`
                    } else if (item.AvgDailyConsupmtion > item.CurrentMonthDailyConsuption) {
                        rows += `<td style="text-align:center;">
                                        <span class ="text-danger" style="font-size:20px;font-weight:900;">↘</span>
                                        <span style="font-weight: 700;">Decreasing</span>
                                    </td>
                                    <td>
                                        <input style="width:100%; text-align:right;" oninput="validateDecimalInput(this)" type="text" class ="minQty" value="${item.SumOfMinQty}" onblur="validateMin(this)">
                                    </td>
                                    <td>
                                        <input style="width:100%; text-align:right;" oninput="validateDecimalInput(this)" type="text" class ="maxQty" value="${item.SumOfMaxQty}" onblur="validateMax(this)">
                                    </td>
                                    <td style="text-align:center;">
                                        <span style="color:#3f51ff;font-size:20px;font-weight:900;">🐢</span>
                                        <span style="font-weight: 700;">&nbsp; Slow</span>
                                    </td>`
                    } else {
                        rows += `<td> </td>
                                        <td> </td>
                                        <td> </td>
                                        <td> </td>`
                    }

                    if (item.AvgConsumption > 0) {
                        if (colorFlag == "black") {
                            rows += `<td style="text-align:center;">
                                        <div class="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #ffffff; outline: 1px solid #000000; pointer-events: none;">
                                            <i class="fa fa-circle" style="color:#000000;"></i>
                                            <strong style="color:#000000;font-weight: 900;">Black</strong>
                                        </div>
                                        </td>

                                    <td style="color:#000000;font-weight: 900; text-align:center;">Purchase today</td>`
                        } else if (colorFlag == "red") {
                            rows += `<td style="text-align:center;">
                                        <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #FCEEEE; outline: 1px solid #E4201C; pointer-events: none;">
                                            <i class ="fa fa-circle" style="color:#E4201C;"></i>
                                            <strong style="color:#E4201C;font-weight: 900;">Red</strong>
                                        </div>
                                        </td>

                                        <td style="color:#E4201C;font-weight: 900; text-align:center;">Purchase this week</td>`
                        } else if (colorFlag == "yellow") {
                            rows += `<td style="text-align:center;">
                                        <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #FDF6D0; outline: 1px solid #FE9425; pointer-events: none;">
                                            <i class ="fa fa-circle" style="color:#FE9425;"></i>
                                            <strong style="color:#FE9425;font-weight: 900; text-align:center;">Yellow</strong>
                                        </div>
                                        </td>

                                        <td style="color:#FE9425;font-weight: 900; text-align:center;">Purchase next week</td>`
                        } else if (colorFlag == "green") {
                            rows += `<td style="text-align:center;">
                                        <div class ="btn btn-sm" style="margin:15px 0; min-width:75px; text-align:left; background: #EDF8F1; outline: 1px solid #00A228; pointer-events: none;">
                                            <i class ="fa fa-circle" style="color:#00A228;"></i>
                                            <strong style="color:#00A228;font-weight: 900;">Green</strong>
                                        </div>
                                        </td>

                                        <td style="color:#00A228;font-weight: 900;">No action</td>`
                        }
                    } else {
                        rows += `<td> </td>
                                 <td> </td>`
                    }
                    if ((item.CovType != "Stranger") && (item.DaysOfStockLeft <= item.LeadTime)) {

                        rows += `<td style="text-align:center" class ="updateBtn" data-matcodeval="${item.MaterialCode}" data-branchcodeval="${item.BranchCode}">
                                    <div class ="btn btn-sm" style="min-width:75px; text-align:left; background: #FAFBFC; outline: 1px solid #5E79E2;" onclick="updateItemRow(this)">
                                        <strong style="color:#5E79E2; font-weight: 900;"">Update</strong>
                                    </div>
                                </td>`


                    } else {
                        rows += `<td></td>`
                    }
                        rows += `</tr>`;
                    });

                    $("#item_MM_table tbody").empty();
                    $("#item_MM_table tbody").html(rows);
                }

              },
            error: function (xhr) {
                alert("Error: " + xhr.status + " - " + xhr.statusText);
            }
        });
    }

    function goCreateMdn(obj) {
        debugger;
        var activeType = $("input[name='activeType']:checked").val();

        var branchCode = $("#ddlUnit").val();
        var materialCode = $(obj).closest("tr").find(".materialCode").data("materialcodeval");

        if (activeType == 0) {
            var stockListGroupCode = $("#ddlStockListGroup").val();
        } else if (activeType == 1) {
            var stockListGroupCode = 0;
        }


        var urlString = `/BranchDeptMinMax/CreateMdn?intActiveType=${activeType}&intBranchCode=${branchCode}&intMaterialCode=${materialCode}&intSlgCode=${stockListGroupCode}`;

        $.ajax({
            url: urlString,
            type: 'GET',
            success: function (response, status, xhr) {
                $("#mainContent").html(response);
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Error : " + xhr.status + " - " + error);
            }
        });


    }

